{
    "name": "nextgen/trackers",
    "type": "phpbb-extension",
    "description": "An incident, security, bug and feature tracker for phpBB.",
    "homepage": "https://nextgen.gt",
    "version": "1.0.0-RC3",
    "time": "2026-02-01",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Melvin Garcia",
            "email": "contact@nextgen.gt",
            "homepage": "https://nextgen.gt",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1.3",
        "composer/installers": "~1.0"
    },
    "autoload": {
        "psr-4": {
            "nextgen\\trackers\\": "."
        }
    },
    "extra": {
        "display-name": "Trackers",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.1.0@dev"
        },
        "version-check": {
            "host": "https://raw.githubusercontent.com",
            "directory": "/nextgen-solutions-gt/trackers/3.3",
            "filename": "trackers_versions.json"
        }
    }
}
